odoo:
  url: https://sas.lachouettecoop.fr
  db: dbsas
  user:
  passwd:
  categories:
    fruits:
      - ["categ_id", "in", [337]]
    legumes:
      - ["categ_id", "in", [418]]
    #vrac:
    #  - ["name", "ilike", "vrac"]
    #  - ["barcode", "ilike", "260%"]
    #viandes:
    #  - [ "categ_id", "in", [ 350, 352]]
  replacements:
    - replacement: "| Pot. des Rai."
      patterns:
        - "- le potager des rainettes -"
        - "- potager des rainettes -"
        - "- Potager des R -"
    - replacement: "| B. Toul."
      patterns:
        - "- B!o Toulousaine -"
    - replacement: "| Jar. de Lou."
      patterns:
        - "- Jardins de Loupiac -"
        - "- Jardins de Loupiac-"
    - replacement: "| Ver. de F."
      patterns:
        - "- Verger de F. -"
    - replacement: "| Jar. de Gir."
      patterns:
        - "- Jardins du Girou -"
    - replacement: "| ETIC"
      patterns:
        - "ETIC"
    - replacement: "| Marty"
      patterns:
        - "- Marty -"
    - replacement: ""
      patterns:
        - vrac
        - au kg
        - 1 kg
        - 1kg
        - bio
        - prix
        - sous vide
        - ss vide
        - à la pièce
        - piece
        - pièce
        - maraîcher
        - conventionnel
        - barquette
        - "\\(toutes variétés\\)"
        - "- toute variété -"
        - toute variété

printer:
  ip: 192.168.70.106

scale:
  ip: 192.168.70.118:1240
